<UserControl
    x:Class="Hitodama.Shell.Tabs.ClipboardTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Hitodama.Shell">

    <Grid RowSpacing="{StaticResource SpMd}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="{StaticResource SpSm}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Search" PlaceholderText="Search clipboard…" CornerRadius="{StaticResource RoundLg}"
                     VerticalContentAlignment="Center" TextChanged="Search_TextChanged" KeyDown="Search_KeyDown" />
            <StackPanel x:Name="Filters" Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource SpSm}" VerticalAlignment="Center" />
            <local:RippleButton Grid.Column="2" Style="{StaticResource IconButton}" Content="delete" Click="Clear_Click"
                    ToolTipService.ToolTip="Clear history (keeps pinned)" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
            <StackPanel x:Name="List" Spacing="{StaticResource SpSm}" />
        </ScrollViewer>

        <StackPanel x:Name="Disabled" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Visibility="Collapsed">
            <FontIcon Style="{StaticResource Glyph}" Glyph="content_paste" FontSize="36" Foreground="{StaticResource Primary}" />
            <TextBlock Style="{StaticResource Body}" HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="Clipboard history is off" />
            <TextBlock Style="{StaticResource Body}" HorizontalAlignment="Center" Foreground="{StaticResource OnSurfaceVariant}"
                       Text="Windows only keeps a history once it's turned on." />
            <local:RippleButton HorizontalAlignment="Center" CornerRadius="18" Height="36" Padding="18,0" BorderThickness="0"
                    Background="{StaticResource Primary}" Foreground="{StaticResource OnPrimary}" FontWeight="SemiBold"
                    Content="Open clipboard settings" Click="OpenSettings_Click" />
        </StackPanel>
    </Grid>
</UserControl>
