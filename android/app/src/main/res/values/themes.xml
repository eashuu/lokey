<resources>
    <style name="Theme.Lokey" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0E0F12</item>
        <item name="android:statusBarColor">#0E0F12</item>
        <item name="android:navigationBarColor">#0E0F12</item>
        <item name="android:textColor">#ECEDEF</item>
        <item name="android:colorAccent">#9D8BFF</item>
    </style>
    <style name="Theme.Lokey.Popup" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/popup_bg</item>
        <item name="android:textColor">#ECEDEF</item>
        <item name="android:colorAccent">#9D8BFF</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>
    <style name="WidgetBtn">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/btn_bg</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">#ECEDEF</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
