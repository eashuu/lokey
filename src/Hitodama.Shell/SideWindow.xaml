<Window
    x:Class="Hitodama.Shell.SideWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Hitodama Side">

    <Grid x:Name="Root" Background="Transparent">
        <Canvas x:Name="SurfaceHost" />
        <Grid x:Name="Panel" Visibility="Collapsed">
            <StackPanel x:Name="Osd" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <StackPanel x:Name="Session" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
